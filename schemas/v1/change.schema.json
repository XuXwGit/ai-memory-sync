{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operation_id",
    "base_revision",
    "operation",
    "source_account",
    "record_id",
    "status"
  ],
  "properties": {
    "operation_id": {
      "type": "string",
      "minLength": 1
    },
    "base_revision": {
      "type": "string"
    },
    "operation": {
      "enum": [
        "upsert",
        "delete"
      ]
    },
    "source_account": {
      "type": "string"
    },
    "record_id": {
      "type": "string"
    },
    "status": {
      "const": "proposal_only"
    }
  }
}
